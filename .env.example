# ── Application ──
APP_NAME=AI-Service
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Database ──
# SQLite (dev): sqlite+aiosqlite:///./data/ai_service.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@localhost:5432/ai_service
DATABASE_URL=sqlite+aiosqlite:///./data/ai_service.db

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── CORS (comma-separated origins for website integration) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-website.com

# ── Auth ──
API_KEY_SECRET=your-super-secret-api-key-change-me
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── AI Models ──
VIDEO_MODEL_ID=THUDM/CogVideoX-5b
VIDEO_MODEL_DEVICE=cuda
TTS_MODEL_ID=tts_models/multilingual/multi-dataset/xtts_v2
TTS_MODEL_DEVICE=cuda

# Livestream micro-scene pipeline
WAV2LIP_API=https://sync.so/settings/api-keys
LIVESTREAM_OUTPUT_WIDTH=720
LIVESTREAM_OUTPUT_HEIGHT=1280
LIVESTREAM_FPS=25
LIVESTREAM_TTS_PROVIDER=auto
LIVESTREAM_TTS_VOICE=vi-VN-HoaiMyNeural
LIVESTREAM_ENABLE_WAV2LIP=false
WAV2LIP_DIR=/content/Wav2Lip
WAV2LIP_CHECKPOINT=/content/Wav2Lip/checkpoints/Wav2Lip-SD-GAN.pt
WAV2LIP_RESIZE_FACTOR=2
WAV2LIP_PADS=[0,20,0,0]

# ── Storage ──
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/outputs
# S3 (optional)
# S3_BUCKET_NAME=ai-service-outputs
# S3_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── WebSocket ──
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL_SEC=30

# ── Wrap Test (Gemini VEO Browser Automation) ──
GEMINI_VEO_URL=https://gemini.google.com/
GEMINI_VIDEO_TOOL_LABEL=Tạo video
GEMINI_ASPECT_RATIO=9:16
GEMINI_ASPECT_LABEL=Dọc (9:16)
# Optional: connect to an already-open, logged-in Chrome to avoid Gemini blocking
# CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_USER_DATA_DIR=
CHROME_EXECUTABLE_PATH=
VEO_DOWNLOAD_DIR=./data/outputs/veo_downloads
VEO_TIMEOUT_SEC=600
VEO_SCENE_LIMIT=0
VEO_SCREENSHOT_DIR=./data/outputs/screenshots

# ── LLM Provider (for script generation) ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-2.0-flash
LLM_TEMPERATURE=0.7

# ── Google GenAI API (Imagen 3 + Veo 2 for scene generation) ──
# When GEMINI_API_KEY is set and GENAI_PREFER_API=true, the pipeline uses
# Imagen 3 for keyframe images and Veo 2 for scene videos (paid API).
# If the API fails (rate-limit, quota, error), it falls back to local pipeline.
GENAI_PREFER_API=true
GENAI_IMAGEN_MODEL=imagen-3.0-generate-002
GENAI_VEO_MODEL=veo-2.0-generate-001
GENAI_ASPECT_RATIO=16:9
# Cheaper default: skip Imagen and send uploaded model/product references to Veo.
GENAI_USE_IMAGEN=false
# Veo already creates motion; keep Wav2Lip for local fallback only.
GENAI_SKIP_WAV2LIP=true
GENAI_ENHANCE_PROMPT=true

# ── Pipeline Input ──
PIPELINE_INPUT_PATH=./data/inputs/input.json
